<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.androidapp.pizzamania.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home_ui" />

    <fragment
        android:id="@+id/navigation_menu"
        android:name="com.androidapp.pizzamania.ui.menu.MenuFragment"
        android:label="Menu"
        tools:layout="@layout/fragment_menu_ui" />

    <fragment
        android:id="@+id/navigation_cart"
        android:name="com.androidapp.pizzamania.ui.cart.CartFragment"
        android:label="Cart"
        tools:layout="@layout/fragment_cart_ui" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.androidapp.pizzamania.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.androidapp.pizzamania.ui.notifications.NotificationsFragment"
        android:label="Notification"
        tools:layout="@layout/fragment_notifications" />
</navigation>