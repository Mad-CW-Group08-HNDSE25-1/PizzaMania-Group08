<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ManageMenuActivity"
    android:background="#F5F5F5">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Menu"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/arrow_backward_icon"
            android:contentDescription="Back"
            app:tint="@color/black" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Search -->
    <SearchView
        android:id="@+id/searchItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:queryHint="Search items..."
        android:iconifiedByDefault="false"
        android:background="@drawable/search_background"
        android:layout_margin="12dp"
        android:elevation="4dp"
        android:layout_below="@id/toolbar" />

    <!-- RecyclerView fills space above button -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMenuItems"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:layout_below="@id/searchItem"
        android:layout_above="@id/addMenuItemBtn" />

    <!-- ProgressBar centered -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- Fixed Add Button at bottom -->
    <Button
        android:id="@+id/addMenuItemBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Menu Item"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_margin="12dp"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@color/orange_500"
        android:textColor="@android:color/white" />

</RelativeLayout>