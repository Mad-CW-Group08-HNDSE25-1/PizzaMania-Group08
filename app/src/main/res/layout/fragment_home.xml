<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200px"
            android:background="@color/backColor1"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="110px"
                android:layout_height="110px"
                android:layout_marginLeft="25px"
                android:layout_marginTop="40px"
                android:background="@drawable/circle"
                android:padding="20px"
                android:scaleType="centerInside"
                android:src="@drawable/location_icon"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="750px"
                android:layout_height="match_parent"
                android:layout_marginLeft="30px"
                android:layout_marginTop="40px"
                android:text="Give us your exact location for seamless delivery"
                android:textColor="@color/white"
                android:textSize="42px" />

            <Button
                android:id="@+id/btnDetectLocation"
                android:layout_width="400px"
                android:layout_height="120px"
                android:layout_marginTop="40px"
                android:layout_marginRight="25px"
                android:baselineAligned="false"
                android:text="Detect Location"
                android:background="@drawable/rectangle"
                android:textColor="#FFFFFF"
                android:textSize="35px"
                android:textStyle="bold" />

        </LinearLayout>


        <ImageView
            android:layout_width="530dp"
            android:layout_height="317dp"
            android:src="@drawable/background2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <SearchView
                android:id="@+id/searchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:queryHint="Search your favourites.."
                android:iconifiedByDefault="false"
                android:background="@drawable/search_background"
                android:layout_margin="25px"
                android:elevation="15px"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="40px"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categories"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="48px"
            android:layout_marginLeft="40px"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="210dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingRight="20dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/VPimage"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@drawable/cat_vp"
                        app:shapeAppearanceOverlay="@style/Base.Theme.PizzaMania"
                        tools:ignore="MissingConstraints"/>

                    <TextView
                        android:id="@+id/VPtxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Veggie Pizza"
                        android:textSize="50px"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingRight="20dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/NVPimage"
                        android:layout_width="125dp"
                        android:layout_height="125dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/cat_nvp"
                        app:shapeAppearanceOverlay="@style/Base.Theme.PizzaMania"
                        tools:ignore="MissingConstraints"/>

                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="13dp"/>

                    <TextView
                        android:id="@+id/NVPtxt"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="Non-Veggie Pizza"
                        android:textAlignment="center"
                        android:textSize="50px"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingRight="20dp"
                    android:paddingLeft="12dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/BevImage"
                        android:layout_width="125dp"
                        android:layout_height="125dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/cat_bev"
                        app:shapeAppearanceOverlay="@style/Base.Theme.PizzaMania"
                        tools:ignore="MissingConstraints"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="40px"/>

                    <TextView
                        android:id="@+id/BevTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Breverages"
                        android:textSize="50px"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingRight="20dp"
                    android:paddingLeft="12dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/DesImage"
                        android:layout_width="125dp"
                        android:layout_height="125dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/cat_des"
                        app:shapeAppearanceOverlay="@style/Base.Theme.PizzaMania"
                        tools:ignore="MissingConstraints"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="40px"/>

                    <TextView
                        android:id="@+id/DesTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Deserts"
                        android:textSize="50px"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </LinearLayout>


            </LinearLayout>
        </HorizontalScrollView>


        <TextView
            android:id="@+id/tv_offers_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offers"
            android:textStyle="bold"
            android:textSize="48px"
            android:textColor="@color/black"
            android:layout_marginLeft="40px"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_offers"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:paddingTop="8dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Order"
            android:textStyle="bold"
            android:textSize="48px"
            android:textColor="@color/black"
            android:layout_marginLeft="40px"
            android:paddingTop="16dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecentOrderView"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tv_no_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No recent orders"
            android:textAlignment="center"
            android:textColor="#757171"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_recent_label" />



    </LinearLayout>

</ScrollView>